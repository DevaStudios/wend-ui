{
  "name": "@devastudios/icons",
  "version": "0.1.0",
  "description": "Curated SVG icon set for the wend-ui design system",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "type": "module",
  "main": "dist/manifest.json",
  "exports": {
    ".": "./dist/manifest.json",
    "./svg/*.svg": "./dist/svg/*.svg",
    "./svg-strings": "./dist/svg-strings.json",
    "./get-icon-svg": {
      "types": "./dist/get-icon-svg.d.ts",
      "import": "./dist/get-icon-svg.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "rimraf": "^5.0.5"
  }
}
