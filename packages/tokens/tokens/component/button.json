{
  "button": {
    "padding-block": { "value": "{spacing.100}" },
    "padding-inline": { "value": "{spacing.200}" },
    "radius": { "value": "{radius.medium}" },
    "font-size": { "value": "{font.size.200}" },
    "font-weight": { "value": "{font.weight.regular}" }
  },
  "color": {
    "button": {
      "primary": {
        "background": {
          "default": { "value": "{color.action.primary.background}" },
          "hover": { "value": "{color.action.primary.background-hover}" },
          "active": { "value": "{color.action.primary.background-active}" },
          "disabled": { "value": "{color.action.primary.background-disabled}" }
        },
        "foreground": {
          "default": { "value": "{color.text.on-primary}" },
          "disabled": { "value": "{color.text.disabled}" }
        }
      },
      "secondary": {
        "foreground": {
          "default": { "value": "{color.action.secondary.foreground}" }
        },
        "border": {
          "default": { "value": "{color.action.secondary.foreground}" }
        }
      }
    }
  }
}
