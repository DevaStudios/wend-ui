{
  "help-text": {
    "padding-block": { "value": "{spacing.50}" },
    "padding-inline": { "value": "{spacing.100}" },
    "radius": { "value": "{radius.medium}" },
    "font-size": { "value": "{font.size.150}" }
  },
  "color": {
    "help-text": {
      "default": {
        "foreground": {
