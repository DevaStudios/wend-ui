        "foreground": {
          "default": { "value": "{color.text.success}" }
        }
      },
      "warning": {
        "background": {
          "default": { "value": "{color.feedback.warning.background-subtle}" }
        },
        "foreground": {
          "default": { "value": "{color.text.warning}" }
        }
      },
      "error": {
        "background": {
          "default": { "value": "{color.feedback.danger.background-subtle}" }
        },
        "foreground": {
          "default": { "value": "{color.text.danger}" }
        }
      }
