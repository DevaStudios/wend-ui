{
  "select": {
    "height": { "value": "{sizing.500}" },
    "padding-block": { "value": "{spacing.50}" },
    "padding-inline": { "value": "{spacing.200}" },
    "radius": { "value": "{radius.medium}" },
    "border-width": { "value": "1px" },
    "gap": { "value": "{spacing.100}" },
    "label-font-size": { "value": "{font.size.175}" },
    "value-font-size": { "value": "{font.size.175}" },
    "chevron-size": { "value": "{sizing.200}" },
    "focus": {
      "outline-color": { "value": "{color.border.focus}" },
      "outline-width": { "value": "1px" },
      "outline-offset": { "value": "0" }
    },
    "required-marker": {
      "gap": { "value": "{spacing.25}" }
    },
    "panel": {
      "radius": { "value": "{radius.medium}" },
      "padding": { "value": "{spacing.50}" },
      "offset": { "value": "{spacing.50}" },
      "shadow": { "value": "0 1px 2px rgba(51, 51, 51, 0.2)" }
    }
  },
  "color": {
    "select": {
      "label": {
        "foreground": {
          "default": { "value": "{color.text.primary}" }
        }
      },
      "content": {
        "foreground": {
          "default": { "value": "{color.text.primary}" }
        }
      },
      "chevron": {
        "foreground": {
          "default": { "value": "{color.text.secondary}" }
        }
      },
      "default": {
        "background": {
          "default": { "value": "{color.surface.input}" }
        },
        "border": {
          "default": { "value": "{color.border.input}" }
        }
      },
      "success": {
        "border": {
          "default": { "value": "{color.border.success}" }
        }
      },
      "warning": {
        "border": {
          "default": { "value": "{color.border.warning}" }
        }
      },
      "error": {
        "border": {
          "default": { "value": "{color.border.danger}" }
        }
      },
      "required-marker": {
        "foreground": {
          "default": { "value": "{color.text.danger}" }
        }
      },
      "panel": {
        "background": {
          "default": { "value": "{color.surface.input}" }
        }
      }
    }
